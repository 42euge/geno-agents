direction: down

geno-agents: "geno-agents\nauto-registration · discovery · presence" {
  style: {
    fill: "#1c2128"
    stroke: "#a371f7"
    stroke-width: 2
    border-radius: 8
    font-color: "#a371f7"
    bold: true
  }

  grid-columns: 4

  registry: "registry" {
    style: {
      fill: "#161b22"
      stroke: "#a371f7"
      font-color: "#e6edf3"
      border-radius: 6
    }
  }
  who: "who / find" {
    style: {
      fill: "#161b22"
      stroke: "#a371f7"
      font-color: "#e6edf3"
      border-radius: 6
    }
  }
  status: "status" {
    style: {
      fill: "#161b22"
      stroke: "#a371f7"
      font-color: "#e6edf3"
      border-radius: 6
    }
  }
  update: "update" {
    style: {
      fill: "#161b22"
      stroke: "#a371f7"
      font-color: "#e6edf3"
      border-radius: 6
    }
  }
}

hooks: "hooks (automatic)" {
  style: {
    fill: "#1c2128"
    stroke: "#f0883e"
    stroke-width: 2
    border-radius: 8
    font-color: "#f0883e"
    bold: true
  }

  grid-columns: 2

  h1: "SessionStart\nauto-register" {
    style: {
      fill: "#161b22"
      stroke: "#f0883e"
      font-color: "#e6edf3"
      border-radius: 6
    }
  }
  h2: "PostToolUse\nheartbeat" {
    style: {
      fill: "#161b22"
      stroke: "#f0883e"
      font-color: "#e6edf3"
      border-radius: 6
    }
  }
}

geno-msg: "geno-msg\nlightweight message transport" {
  style: {
    fill: "#1c2128"
    stroke: "#7ee787"
    stroke-width: 2
    border-radius: 8
    font-color: "#7ee787"
    bold: true
  }

  ops: "send · read · notify" {
    style: {
      fill: "#161b22"
      stroke: "#7ee787"
      font-color: "#e6edf3"
      border-radius: 6
    }
  }
}

agents: "agents" {
  style: {
    fill: "#1c2128"
    stroke: "#79c0ff"
    stroke-width: 2
    border-radius: 8
    font-color: "#79c0ff"
    bold: true
  }

  grid-columns: 3

  a: "agent A\ndev-agent\n📋 refactoring\n🔒 build-server" {
    style: {
      fill: "#161b22"
      stroke: "#79c0ff"
      font-color: "#e6edf3"
      border-radius: 6
    }
  }
  b: "agent B\nbrowser\n📋 idle" {
    style: {
      fill: "#161b22"
      stroke: "#79c0ff"
      font-color: "#e6edf3"
      border-radius: 6
    }
  }
  c: "agent C\nmessaging\n📋 fixing race cond\n🔒 geno-msg repo" {
    style: {
      fill: "#161b22"
      stroke: "#79c0ff"
      font-color: "#e6edf3"
      border-radius: 6
    }
  }
}

hooks -> geno-agents: "auto-populates" {
  style: {
    stroke: "#f0883e"
    stroke-width: 2
    font-color: "#8b949e"
    font-size: 12
  }
}
geno-agents -> geno-msg: {
  style: {
    stroke: "#30363d"
    stroke-width: 2
  }
}
geno-msg -> agents: {
  style: {
    stroke: "#30363d"
    stroke-width: 2
  }
}
